<Window
    x:Class="AutoTyper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Auto Typer">
    <Grid>
    <Border x:Name="AppSurface" Padding="32" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Auto Typer" FontSize="30" FontWeight="SemiBold" />
                <Border Padding="8,3" CornerRadius="5" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="v0.1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
            <TextBlock
                Text="Type into your focused app with a natural pace and rhythm."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
            <ToggleButton
                x:Name="PinButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                Click="PinButton_Click"
                ToolTipService.ToolTip="Keep this window above other apps"
                AutomationProperties.Name="Keep window on top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE718;" FontSize="16" />
                    <TextBlock x:Name="PinButtonText" Text="Pin on top" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Border
                Grid.Column="0"
                Padding="22"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Practice text" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Edit this text, then press Start or use the selected hotkey."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBox
                        x:Name="SourceBox"
                        Grid.Row="1"
                        MinHeight="260"
                        SelectionHighlightColorWhenNotFocused="#FFB8860B"
                        SelectionHighlightColor="#FFB8860B"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextChanged="SourceBox_TextChanged"
                        Text="The best way to improve your typing is to practice at a comfortable pace." />
                    <Grid Grid.Row="3" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Pace" />
                            <TextBlock x:Name="PaceValueText" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider
                            x:Name="PaceSlider"
                            Minimum="0.5"
                            Maximum="2"
                            Value="1"
                            StepFrequency="0.1"
                            ValueChanged="PaceSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Rhythm" />
                            <TextBlock x:Name="RhythmValueText" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider
                            x:Name="RhythmSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="0.5"
                            StepFrequency="0.05"
                            ValueChanged="RhythmSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8">
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Mistake chance" />
                            <TextBlock x:Name="MistakeValueText" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider
                            x:Name="MistakeSlider"
                            Minimum="0"
                            Maximum="0.12"
                            Value="0.01"
                            StepFrequency="0.005"
                            ValueChanged="MistakeSlider_ValueChanged" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Delay (s)" VerticalAlignment="Center" FontSize="12" />
                        <NumberBox
                            x:Name="ReadyDelayBox"
                            AutomationProperties.Name="Ready delay in seconds"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="10"
                            Value="2.5"
                            SmallChange="0.5"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="ReadyDelayBox_ValueChanged" />
                        <TextBlock
                            Grid.Column="2"
                            Text="Hotkey"
                            FontSize="12"
                            VerticalAlignment="Center" />
                        <TextBox
                            x:Name="HotkeyInput"
                            Grid.Column="3"
                            IsReadOnly="True"
                            Text="Ctrl+Shift+Space"
                            KeyDown="HotkeyInput_KeyDown" />
                        <Button
                            x:Name="RecordHotkeyButton"
                            Grid.Column="4"
                            Width="32" Height="32" MinWidth="32" Padding="0"
                            AutomationProperties.Name="Change hotkey"
                            Click="RecordHotkeyButton_Click">
                            <ToolTipService.ToolTip>
                                <TextBlock x:Name="HotkeyStatusText" Text="Change hotkey" TextWrapping="Wrap" MaxWidth="300" />
                            </ToolTipService.ToolTip>
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <Border Grid.Column="5" HorizontalAlignment="Right" Padding="8,4" CornerRadius="6"
                                VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <ToolTipService.ToolTip>
                                <StackPanel MaxWidth="350" Spacing="4">
                                    <TextBlock Text="{Binding Text, ElementName=StatusText}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ActivityText" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing x:Name="TypingProgressRing" Width="18" Height="18" MinWidth="18" MinHeight="18"
                                              IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                              AutomationProperties.Name="Typing progress" />
                                <TextBlock x:Name="StatusText" Text="Ready" MaxWidth="95" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="ProgressText" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                <Button Content="Reset progress" Click="ResetButton_Click" />
                <Button
                    x:Name="StopButton"
                    Content="Stop"
                    MinWidth="88"
                    IsEnabled="False"
                    Click="StopButton_Click" />
                <Button
                    x:Name="StartPauseButton"
                    Content="Start"
                    MinWidth="100"
                    Click="StartPauseButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
    <Grid
        x:Name="CountdownOverlay"
        Background="#B3000000"
        IsHitTestVisible="False"
        Visibility="Collapsed">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                Text="Get ready"
                FontSize="26"
                HorizontalAlignment="Center"
                Foreground="White" />
            <TextBlock
                x:Name="CountdownOverlayText"
                Text="3"
                FontSize="96"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Foreground="White" />
            <TextBlock
                Text="Starting shortly"
                FontSize="18"
                HorizontalAlignment="Center"
                Foreground="White" />
        </StackPanel>
    </Grid>
    </Grid>
</Window>
