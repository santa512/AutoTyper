#include <windows.h>

101 ICON "AutoTyperCompact.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Auto Typer Compact - native C++ Win32 edition\0"
            VALUE "FileVersion", "0.2.0.0\0"
            VALUE "InternalName", "AutoTyperCompact\0"
            VALUE "OriginalFilename", "AutoTyperCompact.exe\0"
            VALUE "ProductName", "Auto Typer Compact\0"
            VALUE "ProductVersion", "0.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
