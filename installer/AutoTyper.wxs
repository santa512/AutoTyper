<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.AppName)" Manufacturer="santa512" Version="$(var.AppVersion)"
           UpgradeCode="$(var.UpgradeCode)" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/santa512/AutoTyper" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)">
          <Component Id="Application" Guid="$(var.ComponentGuid)">
            <File Id="AppExe" Source="$(var.AppExe)" Name="$(var.ExeName)" />
            <RegistryValue Root="HKCU" Key="Software\AutoTyper\Installer\$(var.InstallFolder)" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="$(var.AppName)"
                      Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Complete" Title="$(var.AppName)" Level="1">
      <ComponentRef Id="Application" />
    </Feature>
    <?if "$(var.ExeName)" = "AutoTyper.exe" ?>
    <CustomAction Id="RemoveStartup" FileRef="AppExe" ExeCommand="--remove-startup" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveStartup" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <?endif?>
  </Package>
</Wix>
