<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><RootNamespace>AutoTyper</RootNamespace>
    <UseWinUI>true</UseWinUI><EnableMsixTooling>false</EnableMsixTooling><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><PlatformTarget>x64</PlatformTarget><Platforms>x64</Platforms>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../*.cs" Exclude="../../App.xaml.cs" />
    <Compile Include="App.xaml.cs" />
    <ApplicationDefinition Include="../../App.xaml" Link="App.xaml" />
    <Page Include="../../MainWindow.xaml" Link="MainWindow.xaml" />
    <Page Include="../../TrayMenuWindow.xaml" Link="TrayMenuWindow.xaml" />
    <Content Include="../../Assets/AutoTyper.ico" Link="Assets/AutoTyper.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../audio/native/bin/x64/AutoTyperAudio.dll" Link="AutoTyperAudio.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>
</Project>
