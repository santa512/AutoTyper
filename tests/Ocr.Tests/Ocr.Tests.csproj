<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OcrRuntimeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</OcrRuntimeArchitecture>
    <OcrRuntimeArchitecture Condition="'$(OcrRuntimeArchitecture)' == ''">x64</OcrRuntimeArchitecture>
    <PlatformTarget>$(OcrRuntimeArchitecture)</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\EnglishOcr.cs" Link="EnglishOcr.cs" />
    <Compile Include="..\..\ScreenCapture.cs" Link="ScreenCapture.cs" />
    <Compile Include="..\..\ScreenRegionSelector.cs" Link="ScreenRegionSelector.cs" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" ExcludeAssets="build" />
    <Content Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\models\v5\ch_*.onnx"
             Link="Assets\OCR\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\OCR\**" Link="Assets\OCR\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\OcrRuntime\$(OcrRuntimeArchitecture)\*.dll" Link="$(OcrRuntimeArchitecture)\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
