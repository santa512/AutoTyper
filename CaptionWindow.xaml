<Window x:Class="AutoTyper.CaptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Auto Typer · Live captions">
    <Border x:Name="CaptionSurface" Padding="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="CaptionStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                <ScrollViewer x:Name="CaptionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                    <StackPanel Spacing="8"><TextBlock x:Name="FinalCaptions" TextWrapping="Wrap" FontSize="18" IsTextSelectionEnabled="True" /><TextBlock x:Name="PartialCaptions" TextWrapping="Wrap" FontSize="18" Opacity="0.65" /></StackPanel>
                </ScrollViewer>
            </Grid>
            <Expander x:Name="CaptionSummaryPanel" Grid.Row="1" Header="AI summary" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid Height="130" RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="CaptionSummaryStatus" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="CaptionSummaryText" FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer>
                    <Button Grid.Row="2" Width="28" Height="28" MinWidth="28" Padding="0" HorizontalAlignment="Right" Click="SummaryClose_Click" AutomationProperties.Name="Close caption summary" ToolTipService.ToolTip="Close summary"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                </Grid>
            </Expander>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="CaptionLanguage" HorizontalAlignment="Stretch" Height="36" MinHeight="36" AutomationProperties.Name="Caption translation language" MinWidth="100" />
                <ComboBox x:Name="CaptionMode" Grid.Column="1" Height="36" MinHeight="36" MinWidth="112" SelectionChanged="Engine_Changed" AutomationProperties.Name="Caption recognition mode" ToolTipService.ToolTip="Accurate: punctuated captions in short phrases (Whisper, about 60 MB download). Fast: word-by-word captions with lower accuracy (Vosk, about 41 MB). Both run on this PC." />
                <CheckBox x:Name="IncludeMicrophone" Grid.Column="2" Content="Include mic" VerticalAlignment="Center" Checked="Microphone_Changed" Unchecked="Microphone_Changed" ToolTipService.ToolTip="Label microphone captions separately from system audio." />
                <Button x:Name="CaptionTranslate" Grid.Column="3" Width="36" Height="36" MinWidth="36" Padding="0" Click="Translate_Click" IsEnabled="False" AutomationProperties.Name="Translate new captions" ToolTipService.ToolTip="Translate new captions into the main text box"><FontIcon Glyph="&#xF2B7;" FontSize="17" /></Button>
                <Button x:Name="CaptionSummarize" Grid.Column="4" Width="36" Height="36" MinWidth="36" Padding="0" Click="Summarize_Click" IsEnabled="False" AutomationProperties.Name="Summarize captions" ToolTipService.ToolTip="Summarize captions with Groq"><PathIcon Width="18" Height="18" Data="M10,1 L12.6,7.4 L19,10 L12.6,12.6 L10,19 L7.4,12.6 L1,10 L7.4,7.4 Z M20,0 L21.2,2.8 L24,4 L21.2,5.2 L20,8 L18.8,5.2 L16,4 L18.8,2.8 Z" /></Button>
                <ToggleButton x:Name="CaptionPin" Grid.Column="5" IsChecked="True" Width="36" Height="36" MinWidth="36" Padding="0" Click="Pin_Click" AutomationProperties.Name="Keep captions on top" ToolTipService.ToolTip="Keep captions above other windows"><FontIcon Glyph="&#xE718;" FontSize="16" /></ToggleButton>
                <Button x:Name="CaptionRetry" Grid.Column="6" Width="36" Height="36" MinWidth="36" Padding="0" Visibility="Collapsed" Click="Retry_Click" AutomationProperties.Name="Retry caption capture" ToolTipService.ToolTip="Retry caption capture"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
            </Grid>
        </Grid>
    </Border>
</Window>
